  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "convex-test": "^0.0.72",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
