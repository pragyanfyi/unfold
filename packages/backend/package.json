{
  "name": "@unfold/backend",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-local-env.mjs && node scripts/convex-dev.mjs",
    "deploy:check": "node scripts/ensure-local-env.mjs && node scripts/convex-dev.mjs --once --typecheck enable",
