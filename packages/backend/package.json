    "@unfold/interview": "workspace:*",
    "convex": "^1.50.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.73",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
