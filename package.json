{
  "name": "unfold-monorepo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @unfold/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "ci:lint": "biome ci .",
    "test:e2e": "pnpm --filter @unfold/web test:e2e",
    "test:coverage": "pnpm --filter @unfold/web test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  }
}
