# The E2E build (`vite build --mode e2e`) talks to the E2E Convex backend that Playwright starts
# (packages/backend/scripts/e2e-backend.mjs). Loopback only, no secrets. This file beats
# `.env.local`, so a developer's own backend never ends up in the E2E build.
VITE_CONVEX_URL=http://127.0.0.1:3230
VITE_CONVEX_SITE_URL=http://127.0.0.1:3231
