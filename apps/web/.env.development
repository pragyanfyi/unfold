# `pnpm dev` talks to the local Convex backend that `pnpm dev` also starts (packages/backend),
# on its default ports. Loopback only, no secrets. To use another deployment, set these in
# `.env.development.local`, which wins over this file (`.env.local` does not: Vite ranks
# `.env.[mode]` above it).
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
