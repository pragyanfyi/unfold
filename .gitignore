# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.output/
.vinxi/
.wrangler/
coverage/
playwright-report/
test-results/

# Environment and secrets (never commit)
.env
.env.*
!.env.example
# Loopback Convex URLs for `pnpm dev` and the E2E build, no secrets
!apps/web/.env.development
!apps/web/.env.e2e
.dev.vars
.dev.vars.*
!.dev.vars.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code local settings
.claude/settings.local.json

# Local Convex backend data (packages/backend), and the E2E backend's project
.convex/
packages/backend/.e2e/

# TanStack / Nitro caches
.tanstack/
.nitro/
